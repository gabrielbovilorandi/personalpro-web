{
  "hosting": {
    "site": "personalx-redirect",
    "public": "out",
    "trailingSlash": true,
    "redirects": [
      {
        "regex": "^/(?P<caminho>(?:convite|\\.well-known)(?:/.*)?)$",
        "destination": "https://personalpro.app.br/:caminho",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
